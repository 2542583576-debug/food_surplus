# ===== 应用 =====
DEBUG=false
APP_NAME=惜食余量魔法袋
# 生产环境务必替换为长随机字符串：python -c "import secrets;print(secrets.token_urlsafe(48))"
SECRET_KEY=please-change-this-to-a-random-string
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=720

# ===== MySQL =====
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=your-password
MYSQL_DB=food_surplus
# 也可直接使用完整 DSN（设置后上面的 MYSQL_* 会被忽略）
# DATABASE_URL_OVERRIDE=mysql+pymysql://user:pass@host:3306/db?charset=utf8mb4

# ===== Redis（可选）=====
REDIS_ENABLED=false
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
# REDIS_URL_OVERRIDE=redis://:password@host:6379/0

# ===== 跨域：生产环境填写实际前端域名，逗号分隔 =====
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ===== 初始化种子账号 =====
DEFAULT_ADMIN_PASSWORD=admin123
DEFAULT_USER_PASSWORD=user123
